# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=            # Claude reads the listings (leave blank = offline keyword mode)
DASHBOARD_TOKEN=              # password for the web dashboard; set this before exposing it online
DASHBOARD_URL=                # e.g. https://aucbot.example.com, so phone alerts open the lot in the dashboard
POLL_MINUTES=15

# Phone alerts (pick one or both)
NTFY_TOPIC=                   # e.g. aucbot-7f3k9q (hard to guess); subscribe to it in the ntfy app
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Automatic lot feed (used by sources.yaml via ${AUCTION_API_KEY})
AUCTION_API_KEY=
